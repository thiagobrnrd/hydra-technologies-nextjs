# ─────────────────────────────────────────────────────────────
# Hydra Technologies — variáveis de ambiente
# Configure em: Vercel → Project → Settings → Environment Variables
# (e localmente em um arquivo .env.local, que NÃO vai para o Git)
# ─────────────────────────────────────────────────────────────

# Para onde os leads (orçamentos e mensagens) serão enviados
CONTACT_TO_EMAIL=contato.techhydra@gmail.com

# ── Opção A (recomendada): Gmail SMTP ─────────────────────────
# Use uma "Senha de app" do Google (não a senha normal da conta):
# https://myaccount.google.com/apppasswords  (exige verificação em 2 etapas)
SMTP_USER=contato.techhydra@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Opcionais (padrão: Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ── Opção B: Resend ───────────────────────────────────────────
# Só é usada se SMTP_USER/SMTP_PASS não estiverem definidos.
# RESEND_API_KEY=re_xxxxxxxxx
# Remetente com domínio verificado no Resend. Sem isso, usa onboarding@resend.dev
# (que só consegue entregar para o e-mail dono da conta Resend).
# RESEND_FROM=Hydra Technologies <contato@hydratechnologies.com.br>
